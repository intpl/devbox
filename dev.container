[Unit]
Description=Isolated AI devbox (nested podman + opencode)

[Container]
AutoUpdate=registry
Image=localhost/devbox:latest
ContainerName=dev
HostName=devbox
# --privileged is required for nested podman. It is safe HERE only because
# the whole container is rootless: confined to b's subuids, never uid 0 on
# the host. --cpus/--pids-limit protect the host lifeline (ssh/mosh/caddy).
# ??? --cpus=4 --pids-limit=4096 --memory=8g
PodmanArgs=--privileged
PublishPort=127.0.0.1:4000-4009:4000-4009
Volume=%h/syncthing/data/ZabawkaNotEncryptedSync:/root/ZabawkaNotEncryptedSync
Volume=%h/dev:/home/b/dev
Volume=%h/devbox/opencode-config:/root/.config/opencode
Volume=%h/devbox/opencode-local:/root/.local/share/opencode
Volume=%h/devbox/omp:/root/.omp
Volume=inner-storage:/var/lib/containers
EnvironmentFile=%h/devbox/.env

[Service]
Restart=always

[Install]
WantedBy=default.target
