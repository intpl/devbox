{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/deepseek-v4-flash-free",
  "model": "crof/deepseek-v4-pro",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4009,
    "mdns": true,
    "cors": ["https://oc.gladecki.pl"]
  },
  "agent": {
    "deep-research-synthesizer": {
      "mode": "primary",
      "model": "crof/deepseek-v4-pro",
      "permission": {
        "task": "allow"
      }
    },
    "research-thread": {
      "description": "Research subagent: investigates one narrow research question via web search and source fetching, returns structured findings. Invoked only by the deep-research-synthesizer orchestrator.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "hidden": true,
      "tools": {
        "websearch": true,
        "webfetch": true,
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}

