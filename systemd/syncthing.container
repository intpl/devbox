[Unit]
Description=Syncthing

[Container]
AutoUpdate=registry
Image=docker.io/syncthing/syncthing:latest
ContainerName=syncthing
UserNS=keep-id
Environment=PUID=1000
Environment=PGID=1000
Volume=%h/syncthing/config:/var/syncthing/config:Z
Volume=%h/syncthing/data:/var/syncthing/data:Z
# GUI - localhost only
PublishPort=127.0.0.1:8384:8384
# Sync protocol - localhost only (you'll tunnel this too if syncing with remote peers over SSH,
# or leave it off entirely if this device only syncs via other means)
PublishPort=127.0.0.1:22000:22000/tcp
PublishPort=127.0.0.1:22000:22000/udp

[Service]
Restart=always

[Install]
WantedBy=default.target
